async def orbs_loop(user_id: int):
    """Main quest processing loop."""
    global loop_task
    logger.info(f"🔄 orbs_loop started para user_id={user_id}")
    
    try:
        while True:
            logger.info("⏳ Ciclo de orbs iniciado")
            quests = await fetch_orbs_quests()
            
            logger.info(f"📋 API resposta tipo: {type(quests)}")
            logger.info(f"📋 API conteúdo: {str(quests)[:200]}")
            
            if isinstance(quests, dict):
                quest_list = quests.get("quests", [])
                logger.info(f"📋 Total de quests encontrados: {len(quest_list)}")
            else:
                quest_list = quests if isinstance(quests, list) else []
                logger.info(f"📋 Quest list (direct): {len(quest_list)} items")
            
            if not quest_list:
                logger.warning("⚠️ Nenhuma quest encontrada, esperando...")
                await asyncio.sleep(300)  # 5 min
                continue
            
            # Process 1-2 quests
            num_to_process = min(random.randint(1, 2), len(quest_list))
            selected = random.sample(quest_list, num_to_process)
            
            for quest in selected:
                logger.info(f"🎯 Processando quest: {quest.get('id', 'unknown')}")
                await process_single_quest(quest, user_id)
                delay = random.randint(30, 90)
                logger.info(f"⏱️ Esperando {delay}s antes próxima quest...")
                await asyncio.sleep(delay)
            
            await asyncio.sleep(300)  # 5 min entre ciclos
    
    except asyncio.CancelledError:
        logger.info("🛑 orbs_loop cancelado")
        loop_task = None
        raise
    except Exception as e:
        logger.error(f"❌ orbs_loop erro: {e}")
        loop_task = None
